# Configuration for comfyui-watchdog.sh
# Installed to /etc/default/comfyui-watchdog (sourced by the systemd unit).
# Every value here can be overridden at runtime by environment variables.

# --- idle / shutdown policy ---
# GPU is "idle" while utilization stays below this percent.
GPU_UTIL_THRESHOLD=5
# Consecutive idle minutes before the watchdog stops the machine.
IDLE_MINUTES=45
# How often the systemd timer runs this script (must match the timer period).
CHECK_INTERVAL_MIN=5

# --- output sync ---
# Sync the ComfyUI output dir to this bucket/prefix once an hour.
OUTPUT_DIR=/home/ubuntu/ComfyUI/output
S3_BUCKET=REPLACE_ME_BUCKET
S3_OUTPUT_PREFIX=outputs/
SYNC_INTERVAL_MIN=60
S3_SYNC_EXTRA_ARGS=--only-show-errors

# --- service endpoints ---
COMFYUI_URL=http://127.0.0.1:8188

# --- safety ---
# 1 = an interactive login session blocks auto-shutdown (avoids killing a
# session mid-work). Set 0 for the strictest cost control.
COUNT_ACTIVE_SSH_AS_BUSY=1
# 1 = log the shutdown instead of performing it (use for the first deployment).
DRY_RUN=0

# --- state (must persist across stop/start; root EBS volume) ---
STATE_DIR=/var/lib/comfyui-watchdog

# --- commands ---
# SUDO is auto-detected (empty when running as root, "sudo" otherwise).
# Set it explicitly only if you need to override that.
SHUTDOWN_BIN=/usr/sbin/shutdown
SHUTDOWN_DELAY=now
NVIDIA_SMI=nvidia-smi
AWS_BIN=aws
CURL_BIN=curl
