[Unit]
Description=ComfyUI GPU-idle watchdog (auto-shutdown + output sync)
Documentation=file:/usr/local/share/comfyui-watchdog/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/comfyui-watchdog
ExecStart=/usr/local/bin/comfyui-watchdog.sh
# Give the sync/shutdown a little room to finish.
TimeoutStartSec=300
Nice=10
IOSchedulingClass=idle
